extends Node
## The adaptive soundtrack (Olivier, 2026-10-22): the same jaunty "Drunken Sailor", played by a band
## that gets more and more nervous as the ship falls apart. Twelve synced layers (all the same
## length, started together) fade in and out with a hidden stability score; the melody never
## changes, the harmony and rhythm underneath it do. Big events get stings; the band comments.
## Generated by tools/make_adaptive_music.py (public-domain tune, original arrangement).

signal state_changed(state: int)
signal caption(text: String)

const DIR := "res://assets/audio/music/adaptive/"
const BEAT := 0.6 ## 100 BPM
const LAYERS := ["melody", "bass_stable", "chords_stable", "flourish", "perc_light", "perc_busy",
		"bass_chromatic", "counter", "chords_tense", "brass", "perc_frantic", "meltdown"]
const RHYTHM := ["bass_stable", "bass_chromatic", "perc_light", "perc_busy", "perc_frantic"]
## Layer levels (dB) for each state: 4 relaxed, 3 busier, 2 nervous, 1 crisis, 0 meltdown.
const MIX := {
	4: {"melody": 0.0, "bass_stable": 0.0, "chords_stable": -2.0, "perc_light": -6.0},
	3: {"melody": 0.0, "bass_stable": 0.0, "chords_stable": -2.0, "perc_light": -2.0, "flourish": -3.0},
	2: {"melody": 0.0, "bass_chromatic": -1.0, "chords_stable": -5.0, "flourish": -5.0, "perc_light": -3.0,
			"perc_busy": -2.0, "counter": -4.0},
	1: {"melody": 0.0, "bass_chromatic": 0.0, "chords_tense": -2.0, "perc_busy": -2.0, "perc_frantic": -3.0,
			"counter": -2.0, "brass": -3.0},
	0: {"melody": -1.0, "bass_chromatic": 0.0, "chords_tense": 0.0, "perc_frantic": 0.0, "counter": -1.0,
			"brass": -1.0, "meltdown": 0.0},
}
const THRESHOLDS := [20.0, 40.0, 60.0, 80.0] ## stability at which each state starts
const CAPTIONS := {
	4: ["Band: smooth sailing, folks.", "The accordionist hums along."],
	3: ["The accordionist picks up the pace.", "The drummer senses something."],
	2: ["The accordionist is sweating.", "The bassist starts walking. Nervously."],
	1: ["The brass section is panicking.", "The tuba player eyes the lifeboat."],
	0: ["The tuba player has left the building.", "Band: we're fine. Everything's fine."],
}

@export var music_enabled := true
@export_range(-40.0, 6.0) var music_volume_db := -8.0
@export var band_captions := true ## the band's little on-screen comments
@export var ship: Node3D ## leave empty at the dock: the band just plays relaxed
@export var finish_x := 1300.0
@export var hysteresis := 5.0 ## points of stability needed past a threshold before calming down
@export var fall_rate := 30.0 ## stability points per second when things get worse (fast)
@export var rise_rate := 8.0 ## ...and when they get better (slow)
@export var fade_db_per_second := 30.0
@export var faster_near_port := true
@export var port_tempo_boost := 0.06
@export var port_warning_metres := 80.0

var stability := 100.0 ## smoothed, 0..100
var raw_stability := 100.0
var state := 4
var lowest := 100.0 ## lowest stability so far (for the "we narrowly survived" fanfare)

var _players := {}
var _stings := {}
var _dropout_left := 0.0
var _impact_pulse := 0.0
var _deepest_state := 4
var _rng := RandomNumberGenerator.new()


func _ready() -> void:
	_rng.randomize()
	for layer in LAYERS:
		var player := AudioStreamPlayer.new()
		player.name = layer
		player.stream = load(DIR + layer + ".wav")
		player.bus = &"Music"
		player.volume_db = _target_db(layer)
		add_child(player)
		_players[layer] = player
	for sting in ["sting_crash", "sting_honk", "sting_fanfare", "sting_cadence", "sting_sad_trombone"]:
		var player := AudioStreamPlayer.new()
		player.name = sting
		player.stream = load(DIR + sting + ".wav")
		player.bus = &"Music"
		player.volume_db = music_volume_db
		add_child(player)
		_stings[sting] = player
	if music_enabled:
		for player in _players.values():
			player.play() # same frame: the layers stay locked together
	if ship:
		_listen()


func _listen() -> void:
	var handling := ship.get_node("ShipHandling")
	handling.impact.connect(_on_impact)
	ship.get_node("EngineSystem").stalled.connect(_on_stall)
	ship.get_node("RudderSystem").damaged.connect(func(): sting("sting_honk"))
	ship.get_node("LoadSystem").thrown_overboard.connect(func(_c): sting("sting_honk"); say(tr("Someone in the band played a wrong note. On purpose.")))
	ship.get_node("HullSystem").ship_sunk.connect(func(): sting("sting_sad_trombone", true); say(tr("Band: ...and that's our set. Goodnight!")))
	var voyage := get_parent()
	if voyage.has_signal("port_reached"):
		voyage.port_reached.connect(_on_port)


# --- Stability -------------------------------------------------------------------------------

## How well the voyage is going right now, 0 (disaster) to 100 (smooth sailing).
func compute_stability() -> float:
	if ship == null:
		return 100.0
	var penalty := 0.0
	var hull := ship.get_node("HullSystem")
	penalty += hull.water * 55.0 + hull.open_breach_count() * 6.0
	var engine := ship.get_node("EngineSystem")
	if engine.heat > engine.heat_cap_threshold:
		penalty += (engine.heat - engine.heat_cap_threshold) / (1.0 - engine.heat_cap_threshold) * 15.0
	if engine.is_warning():
		penalty += 10.0
	if engine.is_stalled():
		penalty += 15.0
	if engine.fuel < engine.low_fuel:
		penalty += 10.0
	if engine.is_pipe_burst():
		penalty += 5.0
	var rudder: int = ship.get_node("RudderSystem").state
	penalty += [0.0, 5.0, 12.0][rudder]
	var loose := 0
	for crate in get_tree().get_nodes_in_group("cargo"):
		if not crate.lashed and crate.carrier == null:
			loose += 1
	penalty += mini(loose, 3) * 3.0
	if ship.get_node("WaveMotion").is_wave_active():
		penalty += 8.0
	penalty += _impact_pulse
	return clampf(100.0 - penalty, 0.0, 100.0)


func state_for(value: float, current: int) -> int:
	var target := 0
	for threshold in THRESHOLDS:
		if value >= threshold:
			target += 1
	if target > current:
		# Calming down needs a margin past the threshold, so the music doesn't flicker.
		while target > current and value < THRESHOLDS[target - 1] + hysteresis:
			target -= 1
	return target


func _physics_process(delta: float) -> void:
	_impact_pulse = maxf(0.0, _impact_pulse - 4.0 * delta)
	_dropout_left = maxf(0.0, _dropout_left - delta)
	raw_stability = compute_stability()
	var rate := fall_rate if raw_stability < stability else rise_rate
	stability = move_toward(stability, raw_stability, rate * delta)
	lowest = minf(lowest, stability)
	var next := state_for(stability, state)
	if next != state:
		_change_state(next)
	_mix(delta)


func _change_state(next: int) -> void:
	var previous := state
	state = next
	_deepest_state = mini(_deepest_state, state)
	state_changed.emit(state)
	if state >= 3 and _deepest_state <= 1 and previous < state:
		sting("sting_fanfare", true) # a narrow escape: the band can't believe it either
		say(tr("Band: we never doubted you. (We doubted you.)"))
		_deepest_state = state
	else:
		var lines: Array = CAPTIONS[state]
		say(tr(lines[_rng.randi() % lines.size()]))


func _target_db(layer: String) -> float:
	var level = MIX[state].get(layer)
	if level == null or (_dropout_left > 0.0 and RHYTHM.has(layer)):
		return -80.0
	return music_volume_db + level


func _mix(delta: float) -> void:
	var pitch := 1.0
	if faster_near_port and ship:
		var to_port := finish_x - ship.global_position.x
		if to_port < port_warning_metres:
			pitch += port_tempo_boost * clampf(1.0 - to_port / port_warning_metres, 0.0, 1.0)
	for layer in _players:
		var player: AudioStreamPlayer = _players[layer]
		var target := _target_db(layer)
		var step := 200.0 if target < -60.0 and _dropout_left > 0.0 else fade_db_per_second * delta
		if player.volume_db < -60.0 and target > -60.0:
			player.volume_db = target - 12.0 # coming back in: start close, then fade the rest
		player.volume_db = move_toward(player.volume_db, target, step)
		player.pitch_scale = pitch


# --- Events -------------------------------------------------------------------------------------

func _on_impact(_rock: Node3D) -> void:
	_impact_pulse = 25.0
	sting("sting_crash")
	var handling := ship.get_node("ShipHandling")
	if absf(handling.impact_speed) > handling.max_speed * 0.7:
		sting("sting_honk")
	if _rng.randf() < 0.5:
		say(tr("Band: that wasn't in the sheet music."))


## The engine dies: the bass and drums drop out for a beat.
func _on_stall() -> void:
	_dropout_left = BEAT * 1.5
	say(tr("The drummer dropped a stick."))


func _on_port() -> void:
	if lowest < 30.0:
		sting("sting_fanfare", true)
		say(tr("Band: take a bow! Not you. The ship."))
	else:
		sting("sting_cadence", true)
		say(tr("Band: smooth sailing, folks."))
	_impact_pulse = 0.0
	stability = 100.0
	_change_state(4)


## Plays a sting: right away, or on the next beat (musical events: fanfares, cadences).
func sting(sting_name: String, on_beat := false) -> void:
	var player: AudioStreamPlayer = _stings.get(sting_name)
	if player == null or not music_enabled:
		return
	player.volume_db = music_volume_db + 2.0
	if not on_beat:
		player.play()
		return
	var position: float = _players["melody"].get_playback_position() if _players["melody"].playing else 0.0
	var wait := BEAT - fmod(position, BEAT)
	get_tree().create_timer(wait).timeout.connect(player.play)


func say(text: String) -> void:
	if band_captions:
		caption.emit(text)


# --- Mute (M / controller Select) ---------------------------------------------------------------

func _unhandled_input(event: InputEvent) -> void:
	var pressed_m: bool = event is InputEventKey and event.pressed and not event.echo and event.physical_keycode == KEY_M
	var pressed_select: bool = event is InputEventJoypadButton and event.pressed and event.button_index == JOY_BUTTON_BACK
	if pressed_m or pressed_select:
		toggle_mute()


func is_muted() -> bool:
	return AudioServer.is_bus_mute(AudioServer.get_bus_index(&"Music"))


func toggle_mute() -> void:
	AudioServer.set_bus_mute(AudioServer.get_bus_index(&"Music"), not is_muted())
